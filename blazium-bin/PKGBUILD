prepare() {
  cd "${srcdir}"

  cp -f "${pkgbase}-app.blazium.Blazium.desktop" \
    "${pkgbase}-app.blazium.Blazium-mono.desktop"

  desktop-file-edit --set-key="Exec" --set-value="blazium %f" \
    "${pkgbase}-app.blazium.Blazium.desktop"

  desktop-file-edit --set-key="Exec" --set-value="blazium-mono %f" \
    "${pkgbase}-app.blazium.Blazium-mono.desktop"

  desktop-file-edit --set-key="Icon" --set-value="blazium-mono" \
    "${pkgbase}-app.blazium.Blazium-mono.desktop"

  desktop-file-edit --set-key="StartupWMClass" --set-value="blazium" \
    "${pkgbase}-app.blazium.Blazium.desktop"

  desktop-file-edit --set-key="StartupWMClass" --set-value="blazium" \
    "${pkgbase}-app.blazium.Blazium-mono.desktop"

  desktop-file-edit --set-name="Blazium Engine Mono" \
    "${pkgbase}-app.blazium.Blazium-mono.desktop"
}

package_blazium-bin() {
  depends=(
    'glibc'
  )
  provides=(
    "${pkgname%-bin}=${pkgver}"
  )
  conflicts=(
    "${pkgname%-bin}"
  )

  local source_array="source_${CARCH}[0]"
  local source_url="${!source_array}"
  local source_artifact="${source_url##*/}"
  local binname="${source_artifact%.zip}"

  cd "${srcdir}"
  install -vDm755 "${binname}" "${pkgdir}/usr/lib/${_pkgbase}/${pkgname%-bin}"

  install -vDm644 "${pkgbase}-README.md" "${pkgdir}/usr/share/doc/${pkgname%-bin}/README.md"
  install -vDm644 "${pkgbase}-LICENSE.txt" "${pkgdir}/usr/share/licenses/${pkgname%-bin}/LICENSE.txt"

  install -vDm644 "${pkgbase}-icon.svg" "${pkgdir}/usr/share/pixmaps/${pkgname%-bin}.svg"

  install -vDm644 "${pkgbase}-blazium.6" "${pkgdir}/usr/share/man/man6/${pkgname%-bin}.6"
  install -vDm644 "${pkgbase}-app.blazium.Blazium.desktop" \
    "${pkgdir}/usr/share/applications/app.blazium.Blazium.desktop"
  install -vDm644 "${pkgbase}-app.blazium.Blazium.xml" \
    "${pkgdir}/usr/share/metainfo/app.blazium.Blazium.xml"

  install -vd "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/${pkgname%-bin}" << WRAPPER
#!/usr/bin/env sh
if [ -n "\$WAYLAND_DISPLAY" ]; then
    exec /usr/lib/${_pkgbase}/${pkgname%-bin} --display-driver wayland "\$@"
else
    exec /usr/lib/${_pkgbase}/${pkgname%-bin} "\$@"
fi
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/${pkgname%-bin}"
}

package_blazium-mono-bin() {
  depends+=(
    'dotnet-sdk'
  )
  provides=(
    "${pkgname%-bin}=${pkgver}"
  )
  conflicts=(
    "${pkgname%-bin}"
  )

  local source_array="source_${CARCH}[1]"
  local source_url="${!source_array}"
  local source_artifact="${source_url##*/}"
  local binname="${source_artifact%.zip}"

  cd "${srcdir}"
  install -vd "${pkgdir}/usr/lib/${_pkgbase}"
  install -vDm755 "${binname}" "${pkgdir}/usr/lib/${_pkgbase}/${pkgname%-bin}"
  [[ -d "GodotSharp" ]] && cp -a --no-preserve=ownership "GodotSharp" \
    "${pkgdir}/usr/lib/${_pkgbase}/"

  install -vDm644 "${pkgbase}-README.md" "${pkgdir}/usr/share/doc/${pkgname%-bin}/README.md"
  install -vDm644 "${pkgbase}-LICENSE.txt" "${pkgdir}/usr/share/licenses/${pkgname%-bin}/LICENSE.txt"

  install -vDm644 "${pkgbase}-icon.svg" "${pkgdir}/usr/share/pixmaps/${pkgname%-bin}.svg"

  install -vDm644 "${pkgbase}-blazium.6" "${pkgdir}/usr/share/man/man6/${pkgname%-bin}.6"
  install -vDm644 "${pkgbase}-app.blazium.Blazium-mono.desktop" \
    "${pkgdir}/usr/share/applications/app.blazium.Blazium-mono.desktop"
  install -vDm644 "${pkgbase}-app.blazium.Blazium.xml" \
    "${pkgdir}/usr/share/metainfo/app.blazium.Blazium-mono.xml"

  install -vd "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/${pkgname%-bin}" << WRAPPER
#!/usr/bin/env sh
if [ -n "\$WAYLAND_DISPLAY" ]; then
    exec /usr/lib/${_pkgbase}/${pkgname%-bin} --display-driver wayland "\$@"
else
    exec /usr/lib/${_pkgbase}/${pkgname%-bin} "\$@"
fi
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/${pkgname%-bin}"
}
