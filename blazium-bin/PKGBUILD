_pkgbase="blazium"
_pkgname=(
  "${_pkgbase}"
  "${_pkgbase}-mono"
)
pkgbase="${_pkgbase}-bin"
pkgname=(
  "${_pkgname[@]/%/-bin}"
)
pkgver=0.6.725
pkgrel=1
pkgdesc="Blazium Engine - Prebuilt binary from GitHub"
arch=(
  'i686'
  'x86_64'
)

url="https://blazium.app"
_url="https://github.com/blazium-games/blazium"
license=(MIT)
makedepends=(desktop-file-utils)
depends=(glibc)

_tag="v${pkgver}"

source=(
  "${pkgbase}-README.md::${_url}/raw/refs/tags/${_tag}/README.md"
  "${pkgbase}-LICENSE.txt::${_url}/raw/refs/tags/${_tag}/LICENSE.txt"
  "${pkgbase}-icon.svg::${_url}/raw/refs/tags/${_tag}/icon.svg"
  "${pkgbase}-app.blazium.Blazium.desktop::${_url}/raw/refs/tags/${_tag}/misc/dist/linux/app.blazium.Blazium.desktop"
  "${pkgbase}-app.blazium.Blazium.xml::${_url}/raw/refs/tags/${_tag}/misc/dist/linux/app.blazium.Blazium.xml"
  "${pkgbase}-app.blazium.Blazium.appdata.xml::${_url}/raw/refs/tags/${_tag}/misc/dist/linux/app.blazium.Blazium.appdata.xml"
  "${pkgbase}-blazium.6::${_url}/raw/refs/tags/${_tag}/misc/dist/linux/blazium.6"
)
source_i686=(
  "${_url}/releases/download/${_tag}/BlaziumEditor_v${pkgver}_linux.x86_32.zip"
  "${_url}/releases/download/${_tag}/BlaziumEditor_v${pkgver}_linux.mono.x86_32.zip"
)
source_x86_64=(
  "${_url}/releases/download/${_tag}/BlaziumEditor_v${pkgver}_linux.x86_64.zip"
  "${_url}/releases/download/${_tag}/BlaziumEditor_v${pkgver}_linux.mono.x86_64.zip"
)

