# Maintainer: qualk <qualk@qualk.xyz>

pkgname=apps2samsung-beta-bin
_pkgver=2.7.9-beta
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="One-click installer for Samsung Tizen TVs — beta channel (Jellyfin, Moonlight & community catalog)"
arch=('x86_64' 'aarch64')
url="https://github.com/Apps2Samsung/Apps2Samsung"
license=('MIT')
depends=(
  'fontconfig'
  'hicolor-icon-theme'
  'icu'
  'krb5'
  'libglvnd'
  'openssl'
  'zlib'
)
optdepends=(
  'nmap: TV discovery via network scan'
  'xdg-utils: open URLs/files with default handler'
)
provides=('apps2samsung' 'jellyfin2samsung')
conflicts=('apps2samsung' 'jellyfin2samsung' 'apps2samsung-bin')
options=('!strip' '!debug')
source=(
  "LICENSE::https://raw.githubusercontent.com/Apps2Samsung/Apps2Samsung/beta/LICENSE"
)
source_x86_64=(
  "Apps2Samsung-v${_pkgver}-linux-x64.tar.gz::https://github.com/Apps2Samsung/Apps2Samsung/releases/download/v${_pkgver}/Apps2Samsung-v${_pkgver}-linux-x64.tar.gz"
)
source_aarch64=(
  "Apps2Samsung-v${_pkgver}-linux-arm64.tar.gz::https://github.com/Apps2Samsung/Apps2Samsung/releases/download/v${_pkgver}/Apps2Samsung-v${_pkgver}-linux-arm64.tar.gz"
)
sha256sums=('SKIP')
sha256sums_x86_64=('31e2b66879c8ddf6c80874d1ff8e3664ae5644d551aae1065074a8a6bf7195f1')
sha256sums_aarch64=('4834d2f0b0f3c864ee2fbbc0897785e40b7250c49df14648c2459a3ca5d9e6bc')

package() {
  install -vd "${pkgdir}/opt/apps2samsung"
  local _tarball
  _tarball=$(echo "${srcdir}"/Apps2Samsung-v*.tar.gz)
  bsdtar -xf "${_tarball}" -C "${pkgdir}/opt/apps2samsung"

  chmod 755 "${pkgdir}/opt/apps2samsung/Apps2Samsung"
  [[ -f "${pkgdir}/opt/apps2samsung/libSkiaSharp.so" ]] && chmod 755 "${pkgdir}/opt/apps2samsung/libSkiaSharp.so"
  [[ -f "${pkgdir}/opt/apps2samsung/libHarfBuzzSharp.so" ]] && chmod 755 "${pkgdir}/opt/apps2samsung/libHarfBuzzSharp.so"

  # 2.7.9+ stores Downloads/Logs under XDG_CACHE_HOME/XDG_STATE_HOME, but keep
  # compat dirs if older data exists; no need for world-writable /opt subdirs

  install -vd "${pkgdir}/usr/bin"
  ln -vsf "/opt/apps2samsung/Apps2Samsung" "${pkgdir}/usr/bin/apps2samsung"

  install -vd "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/apps2samsung.desktop" << DESKTOP
[Desktop Entry]
Name=Apps2Samsung (Beta)
Exec=/opt/apps2samsung/Apps2Samsung
Icon=apps2samsung
Type=Application
Categories=Utility;
DESKTOP

  if [[ -f "${pkgdir}/opt/apps2samsung/Assets/jelly2sams.png" ]]; then
    install -vDm644 "${pkgdir}/opt/apps2samsung/Assets/jelly2sams.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/apps2samsung.png"
    install -vDm644 "${pkgdir}/opt/apps2samsung/Assets/jelly2sams.png" "${pkgdir}/usr/share/pixmaps/apps2samsung.png"
  fi

  install -vDm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
