# Maintainer: qualk <qualk@qualk.xyz>

pkgname=terminal-code-bin
pkgver=0.3.4
pkgrel=1
pkgdesc='VS Code inside your terminal'
arch=('x86_64' 'aarch64')
url='https://tode.sh'
_url='https://github.com/zenbu-labs/terminal-code'
license=('MIT')
depends=(
  'terminal-browser'
)
provides=("tode")  
conflicts=('tode')  
options=('!strip' '!debug')

_tag="v${pkgver}"
source=(
  "LICENSE::${_url}/raw/${_tag}/LICENSE"
)
source_x86_64=(
  "${_url}/releases/download/${_tag}/tode-linux-x64.tar.gz"
)
source_aarch64=(
  "${_url}/releases/download/${_tag}/tode-linux-arm64.tar.gz"
)
sha256sums=(
  '75144b0fa61c38989a1a057a018806a2da36e99f1f8850ba6146d9f53bdd646f'
)
sha256sums_x86_64=(
  '1df6b77eeee902ee407471957035e47fd29920981798fa4f6aa1f31b89477719'
)
sha256sums_aarch64=(
  'd322df19ac55a8c437af673636b6b17e5a8f865734a83167d6514d034fc47476'
)

package() {  
  install -vd "${pkgdir}/opt/tode"  
  # skip vendor/terminal-browser — the -bin package already provides that binary  
  cp -a "${srcdir}/tode/dist" "${pkgdir}/opt/tode/dist"  
  cp -a "${srcdir}/tode/assets" "${pkgdir}/opt/tode/assets"  
  [ -d "${srcdir}/tode/config" ] && cp -a "${srcdir}/tode/config" "${pkgdir}/opt/tode/config"  
  
  # do NOT ship VERSION/CHANNEL: this keeps tode --upgrade a no-op ("not-an-install"),  
  # so the AUR package, not tode's self-updater, owns upgrades  
  install -vd "${pkgdir}/usr/bin"  
  cat > "${pkgdir}/usr/bin/tode" << 'EOF'
#!/usr/bin/env sh
export TODE_INSTALL_ROOT=/opt/tode
export TODE_TERMINAL_BROWSER_BIN=/opt/terminal-browser/bin/terminal-browser
export ELECTRON_RUN_AS_NODE=1
exec /opt/terminal-browser/electron/electron "$TODE_INSTALL_ROOT/dist/main.js" "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/tode"  
  
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"  
}