# Maintainer: qualk <qualk@qualk.xyz>

pkgname=rkdevtool-bin
pkgver=0.11.0
pkgrel=1
pkgdesc="Cross-platform desktop GUI for Rockchip USB flashing, built with Tauri 2 + Vue 3"
arch=('x86_64')
url="https://github.com/hiifong/rkdevtool"
license=('NOASSERTION')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'hicolor-icon-theme'
)
provides=('rkdevtool')
conflicts=('rkdevtool')
options=('!strip' '!debug')
source=(
  "rkdevtool_${pkgver}_amd64.deb::https://github.com/hiifong/rkdevtool/releases/download/v${pkgver}/rkdevtool_${pkgver}_amd64.deb"
)
sha256sums=('292c8a1f37c62eecb47153aac431b0b73ddc005823e1779fc70edff42c0590cb')
install="${pkgname}.install"

package() {
  # skip non-unicode files
  bsdtar -O -xf "rkdevtool_${pkgver}_amd64.deb" data.tar.gz | \
    bsdtar -xf - -C "${pkgdir}" --exclude="*.pdf"

  # delete redundant folders
  rm -rf "${pkgdir}/usr/lib/rkdevtool/bin/mac"
  rm -rf "${pkgdir}/usr/lib/rkdevtool/bin/windows_x86-64"

  # udev
  if [[ -f "${pkgdir}/lib/udev/rules.d/99-rkdevtool-rockchip.rules" ]]; then
    install -Dm644 "${pkgdir}/lib/udev/rules.d/99-rkdevtool-rockchip.rules" \
      "${pkgdir}/usr/lib/udev/rules.d/99-rkdevtool-rockchip.rules"
    rm -rf "${pkgdir:?}/lib"
  fi

  # patch empty desktop Categories
  if [[ -f "${pkgdir}/usr/share/applications/rkdevtool.desktop" ]]; then
    sed -i 's|^Categories=$|Categories=Development;Utility;|' \
      "${pkgdir}/usr/share/applications/rkdevtool.desktop"
  fi

  # permissions
  chmod 755 "${pkgdir}/usr/bin/rkdevtool"
  [[ -f "${pkgdir}/usr/lib/rkdevtool/bin/linux_x86-64/upgrade_tool" ]] && \
    chmod 755 "${pkgdir}/usr/lib/rkdevtool/bin/linux_x86-64/upgrade_tool"
}